# the next two, i use to help focus by stopping, say, firefox, and then restarting after
# Stop (or suspend, as I like to think of it) a process by name
stop_proc() {
	proc_name="$1"
	killall --signal=STOP "$proc_name"
}

# Continue (or resume, as I like to think of it) a process by name (esp one
# stopped by the `stop-proc` fn)
resume_proc() {
	proc_name="$1"
	killall --signal=CONT "$proc_name"
}

# UTILITY #####################################################################

# alert [MESSAGE...]
#
# Sends a low-urgency desktop notification reporting the exit status of the
# command executed immediately before this function. Uses a terminal icon for
# successful commands and an error icon for failed commands.
#
# If MESSAGE is provided, it is used as the notification text. Otherwise,
# "Command finished" is used.
alert() {
	status_local=$?

	if [ "$status_local" -eq 0 ]; then
		icon=dialog-information
	else
		icon=dialog-error
	fi

	if [ "$#" -gt 0 ]; then
		message=$*
	else
		message="Command finished"
	fi

	notify-send --urgency=low -i "$icon" "$message (exit $status_local)"
}

# Usage: timer <duration> <message>
# Duration supports seconds (s), minutes (m), hours (h), and days (d).
# Examples:
#   timer 30m "Work session done — go walk a lap."
#   timer 10m "Check the oven."
#   timer 1h "Take a break."
#   timer 30m "Time to stretch!" &   # Run in background
timer() {
	TIMER_ALERT_PREFIX="/usr/share/sounds/freedesktop/stereo"
	TIMER_ALERT_SOUND="alarm-clock-elapsed.oga"

	duration="$1"
	shift
	message="$*"

	sleep "$duration"

	notify-send \
		-a timer \
		-u critical \
		"Timer finished" \
		"$message"

	for _ in 1 2; do
		mpv --no-video --really-quiet \
			"$TIMER_ALERT_PREFIX/$TIMER_ALERT_SOUND"
		sleep 1
	done
}
