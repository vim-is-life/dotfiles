# -*- mode: conf -*-
# vim: filetype=conf

### VIDEO SELECTION
# A watch URL downloads one recording.
# Explicitly request playlists when needed.
--no-playlist

### VIDEO QUALITY
# Select separate video and audio streams when available.
# Limit resolution to 720p and exclude AV1.
-f "bv[height<=720][vcodec!^=av01]+ba/b[height<=720][vcodec!^=av01]"

# Prefer higher resolution up to 720p, then smaller files.
-S "res:720,+size"

### HARDWARE COMPRESSION
# After yt-dlp finishes embedding metadata and moving the file,
# encode video to HEVC using NVIDIA NVENC.
# The script retains the original if conversion fails or is larger.
--exec "after_move:sermon-compress %(filepath)q"

### FILENAMES
# Format: Title (YYYY-MM-DD) [YouTube ID].mkv
# Prefer release date, then upload date.
-o "%(title)s (%(release_date>%Y-%m-%d,upload_date>%Y-%m-%d|Unknown)s) [%(id)s].%(ext)s"

# Save in the current working directory.

### CONTAINER
# Package video/audio into MKV without re-encoding.
--remux-video mkv

### DOWNLOAD HISTORY
# Track completed downloads and skip duplicates.
# Relative to the working directory.
--download-archive .downloaded-church

### DOWNLOAD RELIABILITY
# Resume partial downloads.
--continue

# Retry failed network requests and fragments.
--retries 10
--fragment-retries 15

# Wait 5–10 seconds before each download in a playlist.
--min-sleep-interval 5
--max-sleep-interval 10

# Fail rather than silently omit unavailable fragments.
--no-skip-unavailable-fragments

### SUBTITLES
# Prefer manual English subtitles and obtain
# automatic English captions when available.
--write-subs
--write-auto-subs
--sub-langs "en.*"
--sub-format "srt/best"

# Embed available subtitle tracks into MKV.
--embed-subs

### METADATA
# Preserve titles, dates, creators, and other metadata.
--embed-metadata

# Preserve YouTube chapter markers when available.
--embed-chapters

# Attach the complete metadata JSON inside MKV.
--embed-info-json

# Embed the YouTube thumbnail as cover artwork.
--embed-thumbnail

### AUTHENTICATION
# No browser cookies by default.
# Add --cookies-from-browser when required.
