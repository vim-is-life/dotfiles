
# -*- mode: conf -*-
# vim: filetype=conf

### AUDIO SELECTION
# Download playlists when given a playlist URL.
--yes-playlist

# Prefer an existing Opus audio stream.
# Fall back to the best available audio otherwise.
-f "bestaudio[acodec=opus]/bestaudio"

# Prefer free formats when other choices are comparable.
--prefer-free-formats

### AUDIO EXTRACTION
# Extract audio and output an Ogg Opus file.
# Copy existing Opus audio without re-encoding.
# Re-encode other codecs only when necessary.
--extract-audio
--audio-format opus

# Target bitrate for audio that must be re-encoded.
# Does not reduce the bitrate of copied Opus streams.
--audio-quality 96K

### OUTPUT FILES
# Prefix playlist position when available.
# Keep readable titles and YouTube IDs.
-o "./%(playlist_index&{} - |)s%(title)s [%(id)s].%(ext)s"

# Preserve spaces, punctuation, and Unicode.
# No --restrict-filenames.

### DOWNLOAD RELIABILITY
# Resume interrupted downloads.
--continue

# Retry failed requests and fragments.
--retries 10
--fragment-retries 15

# Wait 5–10 seconds before each download in a playlist.
--min-sleep-interval 5
--max-sleep-interval 10

# Fail rather than silently omit unavailable fragments.
--no-skip-unavailable-fragments

### DOWNLOAD HISTORY
# Track completed downloads and skip duplicates.
# Relative to the working directory.
--download-archive .downloaded-audio

### METADATA
# Embed available title, artist, and other metadata.
--embed-metadata

# Embed chapter markers when available.
--embed-chapters

# Embed available cover artwork.
--embed-thumbnail

### AUTHENTICATION
# No browser cookies by default.
# Supply them explicitly when needed.
