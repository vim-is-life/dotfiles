#!/usr/bin/env sh

###############################################################################
# MACHINE CONFIG
###############################################################################

LAPTOP_HOSTNAME="lake-michigan"
WORKSTATION_HOSTNAME="arctic"

# The laptop's built-in display.
#
# If this changes on future hardware, this should be the only place that needs
# updating for the internal panel name.
LAPTOP_INTERNAL_OUTPUT="eDP-1"

# Workspace layout:
#
# Single monitor:
#
#   Main Schl Code M2 Comm KPXC M3 Mdia Agnd Sys
#
# Dual monitor:
#
#   monitor 1: Main Schl Code M2 Comm
#   monitor 2: KPXC M3 Mdia Agnd Sys
#
# On the laptop, the external monitor is monitor 1 and the internal display is
# monitor 2.
MON_1_WORKSPACES="Main Schl Code M2 Comm"
MON_2_WORKSPACES="KPXC M3 Mdia Agnd Sys"

# bspwm creates an initial workspace named "Desktop" before bspwmrc runs.
# Once our configured workspaces exist, remove that initial workspace if it is
# still present and empty.
BSPWM_INITIAL_WORKSPACE="Desktop"

###############################################################################
# DISPLAY POLICY
###############################################################################

# This script deliberately owns the complete XRandR configuration while bspwm
# is running.
#
# Any output that is not part of the desired topology is turned off.
#
# Normally this would make temporary projector/presentation configurations a
# concern: rerunning this script would destroy an ad-hoc XRandR layout.
#
# That is intentionally NOT a concern for this setup. For presentations or any
# unusual display configuration that this script does not support, log out of
# bspwm and use GNOME instead. Therefore, the bspwm configuration can remain
# deterministic and optimized specifically for normal personal use rather than
# trying to act as a general-purpose display manager.
#
# Supported bspwm layouts for now:
#
#   laptop:
#       - internal display only
#       - one external + internal display
#
#   workstation:
#       - one monitor only
#
# TODO:
# If the workstation eventually gets a second monitor, give it the same
# single/dual workspace reconciliation model as the laptop.
#
# TODO:
# The laptop intentionally only supports one external monitor. If multiple
# external monitors become a real use case later, replace the "first external
# output" selection with explicit topology handling.

###############################################################################
# XRANDR HELPERS
###############################################################################

# Print all physically connected outputs.
#
# Example:
#
#   eDP-1
#   HDMI-1
#
# This checks physical connection state rather than active-monitor state.
# That distinction matters for hotplugging because a newly attached output may
# be connected but not yet enabled.
connected_outputs() {
	xrandr --query |
		awk '$2 == "connected" {print $1}'
}

# Print every output known to XRandR, whether connected or disconnected.
all_outputs() {
	xrandr --query |
		awk '$2 == "connected" || $2 == "disconnected" {print $1}'
}

# Find the laptop's external display.
#
# Do NOT assume DisplayPort. Depending on the adapter, dock, or monitor, the
# external output may be named DP-1, DP-2, HDMI-1, HDMI-2, etc.
#
# Since the supported laptop topology is at most one external monitor, simply
# select the first physically connected output other than the internal panel.
laptop_external_output() {
	connected_outputs |
		awk -v internal="$LAPTOP_INTERNAL_OUTPUT" '
            $0 != internal {
                print
                exit
            }
        '
}

# For now the workstation is intentionally assumed to have exactly one connected
# monitor.
#
# TODO:
# Generalize this if the workstation becomes a multi-monitor machine.
workstation_output() {
	connected_outputs | head -n1
}

# Disable every output except those supplied as arguments.
#
# Example:
#
#   disable_other_outputs eDP-1 HDMI-1
#
# leaves eDP-1 and HDMI-1 alone and turns everything else off.
disable_other_outputs() {
	keep_outputs="$*"

	for output in $(all_outputs); do
		keep=false

		for wanted in $keep_outputs; do
			if [ "$output" = "$wanted" ]; then
				keep=true
				break
			fi
		done

		if [ "$keep" = false ]; then
			xrandr --output "$output" --off
		fi
	done
}

###############################################################################
# BSPWM WORKSPACE HELPERS
###############################################################################

workspace_exists() {
	bspc query -D --names |
		grep -Fxq "$1"
}

workspace_is_empty() {
	! bspc query -N -d "$1" | grep -q .
}

# Create a named workspace if bspwm does not already know about it.
#
# This is mainly needed during initial bspwm startup. During a hotplug event the
# workspaces should already exist and will simply be moved between monitors.
ensure_workspace() {
	monitor="$1"
	workspace="$2"

	if ! workspace_exists "$workspace"; then
		# "desktop" is bspwm's CLI terminology for what this configuration calls
		# a workspace.
		bspc monitor "$monitor" -a "$workspace"
	fi
}

ensure_all_workspaces() {
	monitor="$1"

	for workspace in $MON_1_WORKSPACES $MON_2_WORKSPACES; do
		ensure_workspace "$monitor" "$workspace"
	done
}

# bspwm starts with an initial workspace named "Desktop" before bspwmrc runs.
# Our old setup replaced the monitor's workspace list with `bspc monitor -d`,
# which implicitly got rid of it. The hotplug-safe setup instead adds/moves
# workspaces, so that initial workspace would otherwise survive as an 11th
# workspace.
#
# Remove only that known bootstrap workspace, and only when it is empty. If it
# somehow contains a window, leave it alone and warn rather than destroying or
# unexpectedly moving user state.
remove_initial_workspace() {
	workspace="$BSPWM_INITIAL_WORKSPACE"

	if ! workspace_exists "$workspace"; then
		return 0
	fi

	if workspace_is_empty "$workspace"; then
		# "desktop" is bspwm's CLI terminology for removing a workspace.
		bspc desktop "$workspace" -r
	else
		echo \
			"handle-monitors: initial workspace '$workspace' is not empty; leaving it in place" \
			>&2
	fi
}

# Place all workspaces onto one monitor while preserving their existing windows
# and BSP trees.
#
# This is intentionally different from:
#
#   bspc monitor ... -d ...
#
# During hotplugging the workspaces already exist. We want to move those
# workspaces rather than redefine the monitor's workspace set.
put_all_workspaces_on() {
	monitor="$1"

	ensure_all_workspaces "$monitor"

	for workspace in $MON_1_WORKSPACES $MON_2_WORKSPACES; do
		# "desktop" is bspwm's CLI terminology for a workspace selector.
		bspc desktop "$workspace" -m "$monitor"
	done

	remove_initial_workspace
}

# Split the existing workspaces into the normal 5 + 5 dual-monitor arrangement.
split_workspaces_between() {
	monitor_1="$1"
	monitor_2="$2"

	# During initial bspwm startup, establish the named workspaces first.
	ensure_all_workspaces "$monitor_1"

	for workspace in $MON_1_WORKSPACES; do
		bspc desktop "$workspace" -m "$monitor_1"
	done

	for workspace in $MON_2_WORKSPACES; do
		bspc desktop "$workspace" -m "$monitor_2"
	done

	remove_initial_workspace
}

###############################################################################
# LAPTOP
###############################################################################

setup_laptop_only() {
	#
	# Result:
	#
	#   +----------------------------------------------------------+
	#   | eDP-1                                                    |
	#   | primary                                                  |
	#   |                                                          |
	#   | Main Schl Code M2 Comm KPXC M3 Mdia Agnd Sys             |
	#   +----------------------------------------------------------+
	#

	# First make sure the surviving monitor is active.
	#
	# This is important when transitioning from external + laptop back to just
	# the laptop.
	xrandr \
		--output "$LAPTOP_INTERNAL_OUTPUT" \
		--auto \
		--primary \
		--pos 0x0

	# Move all existing bspwm workspaces onto the surviving monitor BEFORE
	# disabling the external display.
	#
	# This gives us explicit control over workspace migration rather than
	# relying on bspwm's remove_disabled_monitors behavior to decide where they
	# should go.
	put_all_workspaces_on "$LAPTOP_INTERNAL_OUTPUT"

	# bspwm now has one logical monitor in our desired ordering.
	bspc wm -O "$LAPTOP_INTERNAL_OUTPUT"

	# Now shut down everything else.
	disable_other_outputs "$LAPTOP_INTERNAL_OUTPUT"
}

setup_laptop_external() {
	external="$1"

	#
	# Result:
	#
	#       LEFT / PRIMARY                    RIGHT
	#
	#   +-------------------------+     +-------------------------+
	#   | external                |     | eDP-1                   |
	#   |                         |     |                         |
	#   | Main                    |     | Mdia                    |
	#   | Schl                    |     | KPXC                    |
	#   | Code                    |     | M3                      |
	#   | M2                      |     | Agnd                    |
	#   | Comm                    |     | Sys                     |
	#   +-------------------------+     +-------------------------+
	#

	# Bring both outputs online first.
	#
	# The external monitor is always:
	#
	#   - left of the laptop
	#   - primary
	#
	# --auto intentionally avoids hard-coding a resolution so different HDMI
	# or DisplayPort monitors can be hotplugged without modifying this script.
	xrandr \
		--output "$external" \
		--auto \
		--primary \
		--pos 0x0 \
		--output "$LAPTOP_INTERNAL_OUTPUT" \
		--auto \
		--right-of "$external"

	# Turn off anything outside the supported two-monitor topology.
	disable_other_outputs \
		"$external" \
		"$LAPTOP_INTERNAL_OUTPUT"

	# Keep bspwm's monitor ordering aligned with the physical layout:
	#
	#   external -> laptop
	#
	# This also makes next/previous monitor navigation predictable should we
	# add bindings for it later.
	bspc wm -O \
		"$external" \
		"$LAPTOP_INTERNAL_OUTPUT"

	# Move the existing workspaces into their normal groups.
	split_workspaces_between \
		"$external" \
		"$LAPTOP_INTERNAL_OUTPUT"
}

setup_laptop() {
	external="$(laptop_external_output)"

	if [ -n "$external" ]; then
		setup_laptop_external "$external"
	else
		setup_laptop_only
	fi
}

###############################################################################
# WORKSTATION
###############################################################################

setup_workstation() {
	monitor="$(workstation_output)"

	if [ -z "$monitor" ]; then
		echo "handle-monitors: no connected workstation monitor found" >&2
		return 1
	fi

	#
	# For now the workstation intentionally has the simplest possible policy:
	#
	#   exactly one connected monitor
	#   all ten workspaces on that monitor
	#
	# We do not currently need hotplugged multi-monitor behavior here.
	#
	# TODO:
	# If the workstation eventually gets a second monitor, reuse the laptop's
	# 5 + 5 workspace splitting approach.

	xrandr \
		--output "$monitor" \
		--auto \
		--primary \
		--pos 0x0

	disable_other_outputs "$monitor"

	bspc wm -O "$monitor"

	put_all_workspaces_on "$monitor"
}

###############################################################################
# MACHINE DISPATCH
###############################################################################

hostname="$(hostname)"

case "$hostname" in
"$LAPTOP_HOSTNAME")
	setup_laptop
	;;

"$WORKSTATION_HOSTNAME")
	setup_workstation
	;;

*)
	echo \
		"handle-monitors: no monitor configuration for hostname '$hostname'" \
		>&2
	exit 1
	;;
esac
