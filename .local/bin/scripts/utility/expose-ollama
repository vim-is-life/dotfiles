#!/bin/sh
set -e

###############################################################################
#                 expose-ollama: forward ollama via tailscale                 #
###############################################################################

OLLAMA_PORT=11434

quit=false

while getopts "q" opt; do
	case "$opt" in
	q)
		quit=true
		;;
	?)
		echo "Usage: $0 [-q]" >&2
		exit 1
		;;
	esac
done

if [ "$quit" = true ]; then
	echo "Stopping Ollama Tailscale exposure..."
	tailscale serve --tcp="$OLLAMA_PORT" off
else
	echo "Exposing Ollama on Tailscale port $OLLAMA_PORT..."
	tailscale serve --bg \
		--tcp="$OLLAMA_PORT" \
		"tcp://127.0.0.1:$OLLAMA_PORT"
fi
