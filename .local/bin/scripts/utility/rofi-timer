#!/usr/bin/env sh

###############################################################################
#                                  rofi-timer                                 #
###############################################################################
# Created: 2026-10-27
# Purpose: Start a timer through Rofi with an optional message.
# Deps: rofi, notify-send, mpv, sleep, tr; timer() from ~/.config/shell/funcs

. "$HOME/.config/shell/funcs"

config_dir="$HOME/.config/rofi-timer"
defaults="$config_dir/defaults.conf"
parser="$config_dir/parse-defaults.awk"

# WHY: Read presets from the requested section without coupling durations
# to messages. Missing configuration means no presets.
get_defaults() {
	[ -f "$defaults" ] || return 0
	awk -v section="$1" -f "$parser" "$defaults"
}

# Offer preset durations while still accepting custom input.
duration=$(get_defaults durations | rofi -dmenu -i -p "Timer duration") || exit 0

# Normalize whitespace and capitalization (e.g., "15 M" -> "15m").
duration=$(printf '%s' "$duration" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')

# WHY: Sleep requires digits followed by a single valid time unit.
if ! printf '%s\n' "$duration" | grep -Eq '^[0-9]+[smhd]$'; then
	notify-send -u critical "Invalid timer duration" "$duration"
	exit 1
fi

# Offer independent message presets; custom and empty messages are allowed.
message=$(get_defaults messages | rofi -dmenu -i -p "Timer message (optional)") || exit 0

# Run timer asynchronously and notify immediately.
timer "$duration" "$message" >/dev/null 2>&1 &
notify-send "Timer started" "$duration — ${message:-No message}"
