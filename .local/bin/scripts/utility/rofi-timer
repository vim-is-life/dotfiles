#!/usr/bin/env sh

###############################################################################
#                                  rofi-timer                                 #
###############################################################################
# Created: 2026-10-27
# Purpose: Start a timer through Rofi with an optional message.
# Deps: rofi, notify-send, mpv, sleep, tr; timer() from ~/.config/shell/funcs

. "$HOME/.config/shell/funcs"

# Prompt for duration; exit if canceled.
duration=$(rofi -dmenu -p "Timer duration?") || exit 0

# Normalize input: remove spaces and convert to lowercase.
duration=$(printf '%s' "$duration" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')

# WHY: Require one or more digits followed by exactly one time unit
# (s/m/h/d), preventing malformed values from reaching sleep.
if ! printf '%s\n' "$duration" | grep -Eq '^[0-9]+[smhd]$'; then
	notify-send -u critical "Invalid timer duration" "$duration"
	exit 1
fi

# Prompt for optional message; exit if canceled.
message=$(rofi -dmenu -p "Timer message (optional)") || exit 0

# Start timer in background and confirm.
timer "$duration" "$message" >/dev/null 2>&1 &
notify-send -a timer "Timer started" "$duration — ${message:-No message}"
